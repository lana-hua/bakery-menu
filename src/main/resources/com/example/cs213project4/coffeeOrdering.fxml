<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cs213project4.CoffeeController">
   <top>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Order Coffee!" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <font>
            <Font name="October Condensed Devanagari Black" size="67.0" />
         </font>
         <BorderPane.margin>
            <Insets top="50.0" />
         </BorderPane.margin>
      </Text>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ComboBox fx:id="coffeeSize" prefHeight="41.0" prefWidth="197.0" promptText="Choose Size">
                     <HBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </HBox.margin>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </ComboBox>
                  <ImageView fitHeight="89.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="27.0" prefWidth="600.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Select AddIn To Add or Remove Here">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Text>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Total AddIns for Order" textAlignment="CENTER">
                     <HBox.margin>
                        <Insets left="170.0" />
                     </HBox.margin>
                  </Text>
               </children>
            </HBox>
            <HBox prefHeight="252.0" prefWidth="600.0">
               <children>
                  <ListView fx:id="alladdInListView" prefHeight="200.0" prefWidth="200.0">
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </ListView>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Button fx:id="addAddIn" mnemonicParsing="false" onAction="#addAddIn" prefHeight="26.0" prefWidth="94.0" text="Add">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" top="90.0" />
                           </VBox.margin>
                        </Button>
                        <Button fx:id="removeAddIn" mnemonicParsing="false" onAction="#removeAddIn" prefHeight="26.0" prefWidth="83.0" text="Remove">
                           <VBox.margin>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
                  <ListView fx:id="orderAddInListView" layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="200.0">
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </ListView>
               </children>
            </HBox>
            <HBox prefHeight="43.0" prefWidth="600.0">
               <children>
                  <ComboBox fx:id="coffeeQuantity" prefWidth="150.0" promptText="Quantity">
                     <HBox.margin>
                        <Insets bottom="10.0" left="150.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </ComboBox>
                  <Button fx:id="coffeeAddToOrder" mnemonicParsing="false" onAction="#addCoffeeOrder" text="Add to Order">
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin></Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="42.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="returnToMainMenu" mnemonicParsing="false" onAction="#displayMain" prefHeight="54.0" prefWidth="600.0" text="Return To Menu" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
